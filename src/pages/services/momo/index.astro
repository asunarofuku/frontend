const addresses = [
    {
        postalCode: "700-0822",
        address: "岡山県岡山市北区表町3丁目3‐32 ウエスタンビル３０１",
        fax: "（086）230-4780",
        tel: "（086）230-4780",
    },
    {
        postalCode: "700-0822",
        address: "岡山県岡山市北区表町3丁目3‐32 ウエスタンビル４０１",
        tel: "（086）230-5720",
        fax: "（086）230-5720",
        email: "asunaro_fuku@mx32.tiki.ne.jp",
    },
];

const tocItems: TocItem[] = [
    {
        title: "概要",
        link: "#overview",
    },
    {
